# Copy this file to .env.local and fill in your Supabase values.
# Never expose SUPABASE_SERVICE_ROLE_KEY in browser code.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blockquestbucket

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Discord OAuth & Server Verification
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL= # (Option 1) Webhook URL for #blockquest channel notifications
DISCORD_CHANNEL_ID= # (Option 2) Channel ID for Discord Bot notification message

# Telegram Bot API Verification
TELEGRAM_BOT_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
